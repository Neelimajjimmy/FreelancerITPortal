
@{
    ViewBag.Title = "GetMyBids";
    Layout = "~/Views/Shared/_userLayout.cshtml";
}

@using (Html.BeginForm("GetMyBids", "User", FormMethod.Get))
{
<div class="admin-project-page">
    <div class="container mt-4">

        <h3>My Bids</h3>


        <table class="table table-striped table-bordered mt-3">
            <thead style="background-color:black;color:white">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Days</th>
                    <th>Status</th>

                </tr>
            </thead>

            <tbody>
                @foreach (var item in ViewBag.myBids)
                {
                    <tr>
                        <td>@item.title</td>
                        <td>@item.description</td>
                        <td>@item.amount</td>
                        <td>@item.days</td>
                        <td>@item.pstatus</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
    }
