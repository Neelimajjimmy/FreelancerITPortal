@model project2FreelancerPortal.Models.userReg
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <title>Sign Up</title>
    <style>
        body {
            background: #f3f4f6;
        }

        .main-container {
            min-height: 100vh;
        }

        .left-side {
            background: linear-gradient(to bottom right, #4f46e5, #7c3aed);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

            .left-side img {
                width: 100%;
                max-width: 500px;
            }

            .left-side h1 {
                margin-top: 25px;
                font-weight: bold;
            }

            .left-side p {
                text-align: center;
                font-size: 18px;
                margin-top: 10px;
            }

        .right-side {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        .signup-card {
            width: 100%;
            max-width: 700px;
            border-radius: 20px;
            border: none;
        }

        .violet-btn {
            background-color: #7c3aed;
            color: white;
            border: none;
        }

            .violet-btn:hover {
                background-color: #6d28d9;
                color: white;
            }

        .field-validation-error {
            color: red;
            font-size: 14px;
        }
    </style>

</head>
<body>
    
    <div class="container-fluid main-container">
        <div class="row min-vh-100">

            <!-- Left Side Image Section -->
            <div class="col-md-6 left-side">

                <img src="https://cdn-icons-png.flaticon.com/512/2620/2620971.png" alt="Freelancing IT" />

                <h1>FreelancerDev</h1>

                <p>
                    Connect with clients, showcase your skills,
                    and grow your IT freelancing career.
                </p>

            </div>

            <!-- Right Side Form Section -->
            <div class="col-md-6 right-side">

                <div class="card shadow signup-card">

                    <div class="card-body p-5">

                        @using (Html.BeginForm("createUser", "User",
                            FormMethod.Post,
                            new { enctype = "multipart/form-data" }))
                        {

                            <h2 class="text-center mb-4 fw-bold text-dark">
                                Sign Up
                            </h2>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Name</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.name,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.name)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Email</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.email,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.email)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Address</label>
                                <div class="col-md-8">
                                    @Html.TextAreaFor(m => m.address,
                                        new { @class = "form-control", rows = "3" })
                                    @Html.ValidationMessageFor(m => m.address)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Phone</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.phone,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.phone)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Skills</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.skills,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.skills)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Experience</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.exp,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.exp)
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Photo</label>
                                <div class="col-md-8">
                                    @Html.TextBox("phFile", "",
                                        new { Type = "file", @class = "form-control" })
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Resume</label>
                                <div class="col-md-8">
                                    @Html.TextBox("resumeFile", "",
                                        new { Type = "file", @class = "form-control" })
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-md-4 col-form-label fw-bold">Username</label>
                                <div class="col-md-8">
                                    @Html.TextBoxFor(m => m.username,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.username)
                                </div>
                            </div>

                            <div class="row mb-4">
                                <label class="col-md-4 col-form-label fw-bold">Password</label>
                                <div class="col-md-8">
                                    @Html.PasswordFor(m => m.pass,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.pass)
                                </div>
                            </div>

                            <div class="text-center">
                                <input type="submit"
                                       value="Create Account"
                                       class="btn violet-btn px-5 py-2" />
                            </div>

                            <div class="text-center mt-3 text-success fw-bold">
                                @Html.DisplayFor(m => m.msg)
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
    

</body>
</html>
