@model project2FreelancerPortal.Models.SearchProject
@{
    ViewBag.Title = "userIndex";
    Layout = "~/Views/Shared/_userLayout.cshtml";
}

@using (Html.BeginForm("search_click", "User", FormMethod.Post))
{

    <!-- ================= HERO SECTION ================= -->

    <section class="project-hero">

        <div class="container">

            <div class="hero-content">

                <div class="hero-text">

                    <h1>
                        Find the Right
                        <span>Freelance Projects</span>
                    </h1>

                    <p>
                        Explore exciting opportunities, showcase your skills
                        and grow your freelance career with us.
                    </p>

                    <!-- SEARCH AREA -->

                    <div class="hero-search">

                        <!-- Skills -->
                        <div class="search-field">

                            <label>Skills</label>

                            <div class="input-wrapper">

                                @Html.TextBoxFor(m => m.skills,
    new { @class = "form-control" })

                            </div>

                        </div>


                        <!-- Experience -->
                        <div class="search-field">

                            <label>Experience Level</label>

                            <div class="input-wrapper">

                                @Html.TextBoxFor(m => m.exp,
     new { @class = "form-control" })

                            </div>

                        </div>


                        <!-- Duration -->
                        <div class="search-field">

                            <label>Duration</label>

                            <div class="input-wrapper">

                                @Html.TextBoxFor(m => m.duration,
     new { @class = "form-control" })

                            </div>

                        </div>


                        <!-- Search Button -->

                        <button type="submit"
                                class="hero-search-btn">

                            <span>⌕</span>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <section class="projects-section">

        <div class="container">



            @if (ViewBag.projects != null && ViewBag.projects.Count > 0)
            {
                foreach (var item in ViewBag.projects)
                {
                    <div class="project-card">
                        <div class="project-main">

                            <div class="project-icon project-icon-pink">

                            </div>

                            <div class="project-info">

                                <h3>@item.title</h3>

                                <p>
                                    @item.description
                                </p>

                                <div class="skill-badges">

                                    <span>@item.skill</span>


                                </div>

                            </div>

                        </div>


                        <div class="project-details">

                            <div class="detail-item">
                                <span class="detail-icon"><i class="fa-solid fa-sack-dollar detail-icon"></i></span>
                                <strong>₹ @item.budget</strong>
                            </div>

                            <div class="detail-item">
                                <span class="detail-icon">◷</span>
                                <span>@item.duration</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-icon">   <i class="fa-regular fa-calendar-days detail-icon"></i></span>
                                <span>@item.deadline.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-icon">
                                    <i class="fa-solid fa-chart-line detail-icon"></i>
                                </span>
                                <span>@item.exp</span>
                            </div>

                        </div>


                        <div class="project-action">

                            <span class="status-badge">
                                @item.status
                            </span>


                            @Html.ActionLink(
  "Bid Now",
  "Bidnow",
  "User",
  new { id = item.pid },
  new { @class = "bid-btn" }
  )
                        </div>
                    </div>
                        }

                        }
                        else
                        {   <div class="project-card">
                            <p>
                                No projects found
                            </p>
                        </div>
                        }
                       



                    </div>
        </section>
        }
