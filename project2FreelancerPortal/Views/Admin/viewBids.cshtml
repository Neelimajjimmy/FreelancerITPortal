
@{
    ViewBag.Title = "viewBids";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="admin-project-page">

    <div class="container">

        <!-- Page Header -->

        <div class="admin-page-header">

            <div>

                <h1>Bids for @ViewBag.projectTitle</h1>
            </div>
        </div>

        <div class="projects-table-card">

            <div class="table-responsive">

                <table class="table projects-table">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Profile Photo</th>
                        <th>Resume</th>
                        <th>Email</th>

                        <th>Bid Amount</th>
                        <th width="90">Days</th>

                    </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in ViewBag.bids)
                        {
                            <tr>
                                <td>@item.name</td>

                                <td>
                                    <img src="@Url.Content(item.photo)"
                                         width="80"
                                         height="80"
                                         style="border-radius:50%;object-fit:cover;" />
                                </td>

                                <td>
                                    <a href="@Url.Content(item.resume)"
                                       target="_blank">
                                        View Resume
                                    </a>
                                </td>
                                <td>@item.email</td>
                                <td>@item.amount</td>
                                <td>@item.days</td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        </div>
    </div>
