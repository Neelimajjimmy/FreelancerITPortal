@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "Admin", FormMethod.Get))
{

    <div class="admin-project-page">

        <div class="container">

            <!-- Page Header -->

            <div class="admin-page-header">

                <div>

                    <h1>Projects</h1>

                    <p>
                        Manage and monitor all freelance projects
                    </p>

                </div>

                <a href="@Url.Action("createProject", "Admin")"
                   class="btn-create-project">

                    <i class="fa fa-plus"></i>

                    Create New

                </a>

            </div>




            <div class="projects-table-card">

                <div class="table-responsive">

                    <table class="table projects-table">

                        <thead>

                            <tr>

                                <th>Title</th>

                                <th>Description</th>

                                <th>Skills</th>

                                <th>Budget</th>

                                <th>Duration</th>

                                <th>Deadline</th>

                                <th>Experience</th>

                                <th>Status</th>

                                <th class="actions-column">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in ViewBag.projects)
                            {
                                <tr>
                                    <td>@item.title</td>
                                    <td>@item.description</td>
                                    <td>@item.skills</td>
                                    <td>@item.budget</td>
                                    <td>@item.duration</td>
                                    <td>@item.deadline.ToString("dd/MM/yyyy")</td>
                                    <td>@item.explevel</td>
                                    <td>@item.projstatus</td>
                                    <td>

                                        <div class="table-actions">

                                            <a href="@Url.Action("editProject", "Admin",
                                                   new { id = item.projid })"
                                               class="btn-table-edit">

                                                <i class="fa fa-pencil"></i>
                                                Edit

                                            </a>


                                            <a href="@Url.Action("viewBids", "Admin",
                                                   new { id = item.projid })"
                                               class="btn-table-bids">

                                                <i class="fa fa-users"></i>
                                                Bids

                                            </a>

                                        </div>



                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>
}
