@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Index", "Admin", FormMethod.Get))
{

    <div class="container mt-4">

        <h3>Projects</h3>

        @Html.ActionLink(
               "Create New",
               "createProject",
               "Admin",
               null,
              new { @class = "btn violet-btn mb-3" }
    )
        <table class="table table-striped table-bordered mt-3">
            <thead style="background-color:black;color:white">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Skills</th>
                    <th>Budget</th>
                    <th>Duration</th>
                    <th  width="90">Deadline</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in ViewBag.projects)
                {
                    <tr>
                        <td>@item.title</td>
                        <td>@item.description</td>
                        <td>@item.skills</td>
                        <td>@item.budget</td>
                        <td>@item.duration</td>
                        <td>@item.deadline.ToString("dd/MM/yyyy")</td>
                        <td>@item.explevel</td>
                        <td>@item.projstatus</td>
                        <td>
                            <!-- Edit Icon -->
                            @Html.ActionLink(
               "Edit",
               "editProject",
               "Admin",
                new { id = item.projid },null
               
    )  |
                            @Html.ActionLink(
                 "View Bids",
                 "viewBids",
                 "Admin",
                  new { id = item.projid },null
              
      )

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
