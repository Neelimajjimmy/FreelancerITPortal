@model project2FreelancerPortal.Models.InsertAdmin

@{
    ViewBag.Title = "Admin Registration";
    Layout = null;   // Removes the shared layout
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <title>Admin Registration</title>

    <style>
        body {
            background: #f4f6f9;
        }

        .register-card {
            width: 450px;
            border-radius: 15px;
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
        }
    </style>
</head>

<body>

    <div class="container d-flex justify-content-center align-items-center vh-100">

        <div class="card shadow register-card">

            

            <div class="card-body p-4">
                <h3 class="text-center">Admin Registration</h3>
                @using (Html.BeginForm("adminReg", "Admin", FormMethod.Post))
                {

                    <div class="mb-3">
                        <label class="form-label fw-bold">Name</label>

                        @Html.TextBoxFor(m => m.name,
                            new { @class = "form-control", placeholder = "Enter name" })

                        <div class="text-danger">
                            @Html.ValidationMessageFor(m => m.name)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>

                        @Html.TextBoxFor(m => m.email,
                            new { @class = "form-control", placeholder = "Enter email" })

                        <div class="text-danger">
                            @Html.ValidationMessageFor(m => m.email)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>

                        @Html.TextBoxFor(m => m.phone,
                            new { @class = "form-control", placeholder = "Enter phone number" })

                        <div class="text-danger">
                            @Html.ValidationMessageFor(m => m.phone)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Username</label>

                        @Html.TextBoxFor(m => m.username,
                            new { @class = "form-control", placeholder = "Enter username" })

                        <div class="text-danger">
                            @Html.ValidationMessageFor(m => m.username)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>

                        @Html.PasswordFor(m => m.pass,
                            new { @class = "form-control", placeholder = "Enter password" })

                        <div class="text-danger">
                            @Html.ValidationMessageFor(m => m.pass)
                        </div>
                    </div>

                    <div class="d-grid">
                        <input type="submit"
                               value="Submit"
                               class="btn btn-primary" />
                    </div>

                    <div class="text-center mt-3 text-success fw-bold">
                        @Html.DisplayFor(m => m.msg)
                    </div>
                }

            </div>
        </div>
    </div>

</body>
</html>