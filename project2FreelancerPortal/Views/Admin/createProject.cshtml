@model project2FreelancerPortal.Models.Project
@{
    ViewBag.Title = "createProject";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Add New Project</h2>
@using (Html.BeginForm("createProject", "Admin", FormMethod.Post))
{ 

 <div class="container">


        <div class="form-group">
            <label class="form-label fw-bold">Title</label>

            @Html.TextBoxFor(m => m.title,
                new { @class = "form-control", placeholder = "Enter title" })

            <div class="text-danger">
                @Html.ValidationMessageFor(m => m.title)
            </div>
        </div>


<div class="form-group">
    <label class="form-label fw-bold">Description</label>

    @Html.TextAreaFor(m => m.description,
        new { @class = "form-control", placeholder = "Enter title" })

    <div class="text-danger">
        @Html.ValidationMessageFor(m => m.description)
    </div>
</div>


<div class="form-group">
    <label class="form-label fw-bold">Skills</label>

    @Html.TextBoxFor(m => m.skill,
        new { @class = "form-control", placeholder = "Enter skills" })

    <div class="text-danger">
        @Html.ValidationMessageFor(m => m.skill)
    </div>
</div>

<div class="form-group">
    <label class="form-label fw-bold">Budget</label>

    @Html.TextBoxFor(m => m.budget,
        new { @class = "form-control", placeholder = "Enter budget" })

    <div class="text-danger">
        @Html.ValidationMessageFor(m => m.budget)
    </div>
</div>

<div class="form-group">
    <label class="form-label fw-bold">Duration</label>

    @Html.TextBoxFor(m => m.duration,
        new { @class = "form-control", placeholder = "Enter duration in months" })

    <div class="text-danger">
        @Html.ValidationMessageFor(m => m.duration)
    </div>
</div>

<div class="form-group">
    <label class="form-label fw-bold">Deadline</label>

    @Html.TextBoxFor(m => m.deadline,
     "{0:yyyy-MM-dd}",
     new { @type = "date", @class = "form-control" })

    
</div>

<div class="form-group">
    <label class="form-label fw-bold">Experience Level</label>

    @Html.TextBoxFor(m => m.exp,
        new { @class = "form-control", placeholder = "In years" })

    <div class="text-danger">
        @Html.ValidationMessageFor(m => m.exp)
    </div>
</div>

<div class="mt-2">
    <input type="submit"
           value="Submit"
           class="btn violet-btn px-5 py-2" />
</div>
</div>
}
