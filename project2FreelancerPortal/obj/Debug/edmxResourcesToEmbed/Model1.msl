    <FunctionImportMapping FunctionImportName="sp_GetProposalsByProjectId" FunctionName="freelanceDbModel.Store.sp_GetProposalsByProjectId">
      <ResultMapping>
        <ComplexTypeMapping TypeName="freelanceDbModel.sp_GetProposalsByProjectId_Result">
