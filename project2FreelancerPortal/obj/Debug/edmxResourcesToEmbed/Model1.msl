    <FunctionImportMapping FunctionImportName="sp_InsertProject" FunctionName="freelanceDbModel.Store.sp_InsertProject" />
    <FunctionImportMapping FunctionImportName="sp_editProject" FunctionName="freelanceDbModel.Store.sp_editProject" />
    <FunctionImportMapping FunctionImportName="sp_SearchProjects" FunctionName="freelanceDbModel.Store.sp_SearchProjects" />
    <FunctionImportMapping FunctionImportName="sp_BidProject" FunctionName="freelanceDbModel.Store.sp_BidProject" />
