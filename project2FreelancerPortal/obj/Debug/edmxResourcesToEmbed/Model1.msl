      </ResultMapping>
    </FunctionImportMapping>
    <FunctionImportMapping FunctionImportName="sp_GetProposals" FunctionName="freelanceDbModel.Store.sp_GetProposals">
      <ResultMapping>
        <ComplexTypeMapping TypeName="freelanceDbModel.sp_GetProposals_Result">
